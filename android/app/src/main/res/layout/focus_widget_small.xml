<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_small_risk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ризик втратити 10 годин"
        android:textColor="#FFEF4444"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_small_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 / 10 год"
            android:textColor="#FF9D7DFF"
            android:textSize="12sp"
            android:fontFamily="monospace"/>

        <Button
            android:id="@+id/widget_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="+1"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"/>
    </LinearLayout>
</LinearLayout>
