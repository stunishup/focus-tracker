<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E6141417"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ЦЬОГО ТИЖНЯ"
            android:textColor="#FF6B6B80"
            android:textSize="9sp"/>
        <TextView
            android:id="@+id/widget_large_dates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="пн — нд"
            android:textColor="#FF6B6B80"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/widget_large_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFE8E8F0"
            android:textSize="32sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:textColor="#FF6B6B80"
            android:textSize="20sp"/>
        <TextView
            android:id="@+id/widget_large_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:textColor="#FF6B6B80"
            android:textSize="20sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" год"
            android:textColor="#FF6B6B80"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_large_risk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ризик втратити 10 годин"
        android:textColor="#FFEF4444"
        android:textSize="11sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Використано"
                android:textColor="#FF6B6B80"
                android:textSize="9sp"/>
            <TextView
                android:id="@+id/widget_large_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 год"
                android:textColor="#FF22C55E"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Втрачено"
                android:textColor="#FF6B6B80"
                android:textSize="9sp"/>
            <TextView
                android:id="@+id/widget_large_lost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 год"
                android:textColor="#FFEF4444"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Понад норму"
                android:textColor="#FF6B6B80"
                android:textSize="9sp"/>
            <TextView
                android:id="@+id/widget_large_over"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 год"
                android:textColor="#FFF59E0B"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_large_btn_add"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="+ 1 година"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:background="#FF7C5CFC"
            android:gravity="center"/>

        <TextView
            android:id="@+id/widget_large_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:text="відкрити"
            android:textSize="11sp"
            android:textColor="#FF9D7DFF"
            android:background="#1A7C5CFC"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"/>
    </LinearLayout>
</LinearLayout>
